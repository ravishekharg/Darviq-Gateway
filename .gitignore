node_modules/
npm-debug.log*
package-lock.json.bak

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docker / compose local overrides
docker-compose.override.yml

# Logs
*.log
