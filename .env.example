# Copy this file to .env and adjust as needed. .env is gitignored - never
# commit real values there. Nothing in this file is a real secret; the
# demo API key lives in kong/kong.yml (also clearly labeled as a
# placeholder) because Kong's declarative config, not environment
# variables, is what drives auth in this DB-less setup.

# Host ports the stack publishes. Change these if 8080/8443/8001 are
# already in use on your machine.
NGINX_HTTP_HOST_PORT=8080
NGINX_HTTPS_HOST_PORT=8443
KONG_ADMIN_HOST_PORT=8001

# Demo key-auth credential for the /api/users route (see kong/kong.yml
# consumers.demo-consumer.keyauth_credentials). Provided here only as a
# convenience reference for the curl examples in the README - changing
# this value alone does NOT change what Kong accepts; you must also
# update kong/kong.yml and reload Kong.
DEMO_API_KEY=demo-key-CHANGE-ME-6f3a9c1d
